*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
.env
.env.*

# IDE and OS files
.idea/
.vscode/
.vs/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

