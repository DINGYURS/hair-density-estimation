/FDU_HairFollicleDataset/
/external_data/
/data/
/datasets/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Project planning docs are tracked, generated/private docs are not
/docs/*.docx
/docs/data_report.md
/docs/experiment_log.md


# Training outputs and generated artifacts
/outputs/**
!/outputs/
!/outputs/.gitkeep
!/outputs/visualizations/
!/outputs/visualizations/.gitkeep
!/outputs/density_previews/
!/outputs/density_previews/.gitkeep
!/outputs/checkpoints/
!/outputs/checkpoints/.gitkeep
!/outputs/logs/
!/outputs/logs/.gitkeep
!/outputs/predictions/
!/outputs/predictions/.gitkeep

